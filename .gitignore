# --- OS / editor ---
Thumbs.db
Desktop.ini
.DS_Store
*.swp
.idea/
.vscode/

# --- Phase0 沙箱修复痕迹 ---
.acl-recovery/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Bridge runtime state (never commit) ---
bridge/state/
bridge/certs/
bridge/logs/
*.pem
*.key
*.log
*.jsonl
!docs/**/*.jsonl

# --- ASR models (large, downloaded) ---
models/*
!models/.gitkeep

# --- Android / Gradle ---
app/android/.gradle/
app/android/local.properties
app/android/build/
app/android/*/build/
app/android/captures/
*.apk
*.aab
app/android/keystore.properties
*.jks
*.keystore

# --- Node / web tooling ---
node_modules/
app/web/dist/

# --- Web assets synced into the Android app (generated by scripts/sync_web.*) ---
app/android/app/src/main/assets/web/
app/android/.gradle/
app/android/gradle/wrapper/gradle-wrapper.jar

# --- Secrets ---
.env
.env.*
secrets/

# --- 本地工具（gh CLI 等，仅本机使用，不入库）---
.tools/

# --- 测试/构建临时产物（pytest 临时目录、pip 下载缓存、spike 轮子）---
.tmp/
.pip-tmp/
pytest-cache-files-*/
models/.tmp/
models/.piptmp/
scripts/spike/.tmp/
scripts/spike/*.whl
scripts/spike/*.tar.gz
scripts/spike/.vendor/
scripts/spike/.cache/
bridge/vendor/**/tests/
bridge/vendor/**/*.dist-info/
