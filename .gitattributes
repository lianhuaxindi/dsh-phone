# 统一换行：仓库内存 LF，检出时由 core.autocrlf 决定。
# 关键：任何在 Linux/CI 上执行的脚本必须是 LF，否则 /bin/sh 会报 "bad interpreter"。
* text=auto eol=lf

*.sh        text eol=lf
*.ps1       text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.keystore  binary
*.jks       binary
*.jar       binary
*.whl       binary
*.wav       binary
*.png       binary
*.jpg       binary
*.ico       binary
*.onnx      binary
*.bin       binary
